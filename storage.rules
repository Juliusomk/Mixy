rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidUploadSize() {
      return request.resource != null && request.resource.size > 0 && request.resource.size <= 104857600;
    }

    function isAllowedMediaType() {
      return request.resource != null && (
        request.resource.contentType.matches('image/.*') ||
        request.resource.contentType.matches('video/.*') ||
        request.resource.contentType.matches('audio/.*') ||
        request.resource.contentType == 'application/pdf' ||
        request.resource.contentType == 'text/plain'
      );
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) && isValidUploadSize() && isAllowedMediaType();
    }

    match /posts/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) && isValidUploadSize() && isAllowedMediaType();
    }

    match /stories/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) && isValidUploadSize() && isAllowedMediaType();
    }

    match /reels/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) && isValidUploadSize() && isAllowedMediaType();
    }

    match /messages/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) && isValidUploadSize() && isAllowedMediaType();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
