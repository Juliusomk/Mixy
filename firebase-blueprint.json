        "fileName": { "type": "string", "maxLength": 160 },
        "fileSize": { "type": "number" },
        "fileMime": { "type": "string", "maxLength": 120 },
        "voiceDurationSec": { "type": "number" },
        "voiceWaveform": { "type": "array" },
        "transcript": { "type": "string", "maxLength": 4000 },
        "effectType": { "type": "string", "enum": ["none", "hearts", "sparkles", "confetti", "bubbles"] },
        "sharedItemId": { "type": "string", "maxLength": 128 },
        "sharedItemPreview": { "type": "string", "maxLength": 300 },
        "sharedCreatorUsername": { "type": "string", "maxLength": 30 },
        "sharedCaption": { "type": "string", "maxLength": 300 },
        "forwardedFrom": { "type": "string", "maxLength": 60 },
        "replyToId": { "type": "string", "maxLength": 128 },
        "replyToPreview": { "type": "string", "maxLength": 200 },
        "reactions": { "type": "object" },
        "readBy": { "type": "array" },
        "starredBy": { "type": "array" },
        "deletedFor": { "type": "array" },
        "isEdited": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "isUnsent": { "type": "boolean" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "pollQuestion": { "type": "string", "maxLength": 200 },
        "pollOptions": { "type": "array" },
        "pollVotes": { "type": "object" },
        "pollClosed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "conversationId", "participantIds", "senderId", "senderUsername", "type", "isEdited", "isDeleted", "createdAt", "updatedAt"]
    },
    "ScheduledMessage": {
      "title": "ScheduledMessage",
      "description": "Queued scheduled direct message pending future delivery.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "conversationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "participantIds": { "type": "array" },
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderUsername": { "type": "string", "minLength": 1, "maxLength": 30 },
        "senderPhotoURL": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["text"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "effectType": { "type": "string", "enum": ["none", "hearts", "sparkles", "confetti", "bubbles"] },
        "scheduledFor": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "sent", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "conversationId", "participantIds", "senderId", "senderUsername", "type", "text", "scheduledFor", "status", "createdAt"]
    },
    "GroupInvite": {
      "title": "GroupInvite",
      "description": "Shareable invite token mapping inviteCode to a group conversation.",
      "type": "object",
      "properties": {
        "inviteCode": { "type": "string", "minLength": 6, "maxLength": 32 },
        "conversationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "groupName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "groupPhotoURL": { "type": "string", "maxLength": 500 },
        "memberCount": { "type": "number" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["inviteCode", "conversationId", "groupName", "memberCount", "createdBy", "isActive", "createdAt", "updatedAt"]
    },
    "Note": {
      "title": "Note",
      "description": "Short 100-character status note displayed in DMs.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
