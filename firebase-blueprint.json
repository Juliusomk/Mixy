        "dmBubbleMode": { "type": "boolean" },
        "dmEffectsEnabled": { "type": "boolean" },
        "dmShowTyping": { "type": "boolean" },
        "dmWhoCanMessage": { "type": "string", "enum": ["everyone", "followers", "nobody"] },
        "dmSoundEnabled": { "type": "boolean" },
