      },
      "required": ["id", "authorId", "authorUsername", "text", "expiresAt", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Activity notification targeted to a specific recipient.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recipientId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorUsername": { "type": "string", "minLength": 1, "maxLength": 30 },
        "actorPhotoURL": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["follow", "like", "comment", "reply", "mention", "tag", "message", "story_reaction", "verification", "security", "group_invite", "missed_call", "incoming_call", "repost"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "minLength": 1, "maxLength": 300 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "recipientId", "actorId", "actorUsername", "type", "text", "isRead", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "User-submitted moderation report or support ticket.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reporterId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["post", "reel", "user", "message", "problem"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 120 },
        "details": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["open", "reviewed", "resolved", "dismissed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "reporterId", "targetType", "targetId", "reason", "status", "createdAt", "updatedAt"]
    },
    "VerificationRequest": {
      "title": "VerificationRequest",
      "description": "Creator verification badge request.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "username": { "type": "string", "minLength": 1, "maxLength": 30 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": { "type": "string", "minLength": 1, "maxLength": 60 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "username", "fullName", "category", "reason", "status", "createdAt", "updatedAt"]
    },
    "SessionActivity": {
      "title": "SessionActivity",
      "description": "User login session and security activity log.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
