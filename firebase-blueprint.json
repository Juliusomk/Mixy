    "UserPublic": {
      "title": "UserPublic",
      "description": "Public user profile visible across MIXY feeds, search, and profile pages.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 3, "maxLength": 30, "pattern": "^[a-zA-Z0-9_.]+$" },
        "usernameLower": { "type": "string", "minLength": 3, "maxLength": 30, "pattern": "^[a-z0-9_.]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "bio": { "type": "string", "maxLength": 300 },
        "website": { "type": "string", "maxLength": 200 },
        "location": { "type": "string", "maxLength": 80 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "coverURL": { "type": "string", "maxLength": 500 },
        "isVerified": { "type": "boolean" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "verificationType": { "type": "string", "enum": ["official", "creator"] },
        "verificationStatus": { "type": "string", "enum": ["none", "pending", "verified", "rejected"] },
        "isPrivate": { "type": "boolean" },
        "isDeactivated": { "type": "boolean" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "postsCount": { "type": "number" },
        "showOnlineStatus": { "type": "boolean" },
        "showLastSeen": { "type": "boolean" },
        "profileEffect": { "type": "object" },
        "mood": { "type": "object" },
        "sleepModeActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "usernameLower", "displayName", "isVerified", "isPrivate", "isDeactivated", "role", "followersCount", "followingCount", "postsCount", "createdAt", "updatedAt"]
    },
